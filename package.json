{
  "name": "youtube-node",
  "description": "Youtube API v3 client for nodeJS",
  "version": "2.0.0",
  "packageManager": "pnpm@10.33.4",
  "author": "Paulo McNally <paulomcnally@gmail.com>",
  "types": "./dist/index.d.ts",
  "keywords": [
    "youtube",
    "videos",
    "api"
  ],
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist",
    "eslint": "eslint src --ext .ts --fix",
    "test": "npm run build && mocha --require ts-node/register test/**/*.ts",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "dependencies": {
    "@colors/colors": "^1.6.0",
    "axios": "^1.7.7",
    "prompt": "^1.3.0"
  },
  "directories": {
    "lib": "./dist/lib"
  },
  "main": "./dist/index.js",
  "bin": {
    "youtube": "./dist/bin/youtube.js"
  },
  "bugs": {
    "url": "https://github.com/paulomcnally/youtube-node/issues/new",
    "email": "paulomcnally@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "git://github.com/paulomcnally/youtube-node.git"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.0",
    "@types/node": "^22.0.0",
    "@types/prompt": "^1.1.9",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.57.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-airbnb-typescript": "^18.0.0",
    "eslint-plugin-import": "^2.29.1",
    "mocha": "^10.7.3",
    "should": "^13.2.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.0"
  }
}
